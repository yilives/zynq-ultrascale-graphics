/* PS-only overrides derived from the supplied AXU3EG factory BSP.
 * Include after the new XSA-generated PS/PL tree. Do not import old PL nodes.
 */
&sdhci1 {
    disable-wp;
    no-1-8-v;
};
&dwc3_0 {
    status = "okay";
    dr_mode = "host";
};
&i2c1 {
    clock-frequency = <400000>;
    eeprom@50 {
        compatible = "atmel,24c04";
        reg = <0x50>;
        pagesize = <16>;
    };
    lm75@48 {
        compatible = "nxp,lm75";
        reg = <0x48>;
    };
};
