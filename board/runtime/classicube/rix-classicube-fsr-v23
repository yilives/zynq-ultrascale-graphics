        for m in members:
            name=Path(m.name);assert m.isfile() and name.parts[0]=='classicube' and '..' not in name.parts
            dst=work.joinpath(*name.parts[1:]);assert not dst.is_symlink()
            dst.parent.mkdir(parents=True,exist_ok=True);dst.write_bytes(tf.extractfile(m).read())
            dst.chmod(0o755 if name.parts[1]=='bin' else 0o644)
manifest=json.loads((work/'manifest.json').read_text())
assert all(games.sha(work/n)==v['sha256'] for n,v in manifest.items())
(work/'.verified').write_text(receipt['sha256']+'\n')
sys.path.insert(0,str(work/'bin'))
from rix_capture_source import capture_source
