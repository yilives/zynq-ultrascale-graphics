assert hashlib.sha256(fsr_path.read_bytes()).hexdigest()=='de86960c07507deabb08e79daf6c1adc99315564e041db772ab8152146d3cb13','Approved FPGA FSR runtime is unavailable; load the verified v23 RAM image first'
